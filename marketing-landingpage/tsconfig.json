{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "strict": true,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": false,
    "ignoreDeprecations": "6.0",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
